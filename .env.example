# Database connection string

DATABASE_URL=mongodb://127.0.0.1/your-database-name



# Or use a PG connection string

#DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name



# Used to encrypt JWT tokens

PAYLOAD_SECRET=YOUR_SECRET_HERE



# Used to configure CORS, format links and more. No trailing slash

NEXT_PUBLIC_SERVER_URL=http://localhost:3000



# Secret used to authenticate cron jobs

CRON_SECRET=YOUR_CRON_SECRET_HERE



# Used to validate preview requests

PREVIEW_SECRET=YOUR_SECRET_HERE



# Website admin user (created/updated on server start when both are set)

ADMIN_EMAIL=

ADMIN_PASSWORD=



# DeepL, Google Maps, and reCAPTCHA: Payload admin → Globals → Settings

# Optima CRM API + Image CDN (env — not admin). Property queries / REF still in admin → Optima CRM.

# NEXT_NODE_URL=https://your-crm.optima-crm.com/v3
# NestJS API (MODE = dev | prod): properties/*, commercial_properties/*, and
# account creation (POST /public/accounts for contact and document download).
# (Project detail stays on Yii: constructions/view-by-ref via contact URL)
# NEXT_PUBLIC_CRM_NEST_API_URL_DEV=https://apidev.optima-crm.com
# NEXT_PUBLIC_CRM_NEST_API_URL_PROD=https://api.optima-crm.com
# NEXT_PUBLIC_CRM_API_MODE=prod
# NEXT_PUBLIC_CRM_API_KEY=
# NEXT_PUBLIC_CRM_API_URL_DEV=https://your-crm.optima-crm.com/yiiapp/frontend/web/index.php
# NEXT_PUBLIC_CRM_API_URL_PROD=https://your-crm.optima-crm.com/yiiapp/frontend/web/index.php
# NEXT_PUBLIC_OPTIMA_USER_KEY=
# NEXT_PUBLIC_OPTIMA_AGENCY_ID=
# NEXT_PUBLIC_OPTIMA_BROCHURE_TEMPLATE_ID=39
# NEXT_PUBLIC_OPTIMA_SITE_ID=237
# NEXT_PUBLIC_OPTIMA_IMAGE_URL_WITHOUT_RESIZE=https://images.optima-crm.com/cms_medias/
# NEXT_PUBLIC_OPTIMA_IMAGE_URL=https://images.optima-crm.com/resize/cms_medias/
# NEXT_PUBLIC_OPTIMA_COMMERCIAL_IMAGE_BASE=https://images.optima-crm.com/commercial_images/
# NEXT_PUBLIC_OPTIMA_CONSTRUCTIONS_IMAGE_BASE=https://images.optima-crm.com/constructions_images
# NEXT_PUBLIC_OPTIMA_PROPERTY_RESIZE_BASE=https://images.optima-crm.com/resize/

# Property list CRM fetch method: auto (default), get, or post

# auto = GET for normal lists, POST for map-area / favorites filters

NEXT_PUBLIC_CRM_PROPERTIES_LIST_METHOD=post

